{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovaOSSimulatorArchetype",
  "type": "object",
  "required": ["name", "description", "hidden_facts", "disclosure_willingness", "success_signal"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "hidden_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "disclosure_willingness": {
      "type": "string",
      "enum": ["open", "cautious", "guarded"]
    },
    "success_signal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "language_register": {
      "type": "string",
      "maxLength": 200
    },
    "demographic": {
      "type": "object",
      "additionalProperties": true
    },
    "failure_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "termination_conditions": {
      "type": "object",
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "success_signal_in_target_response": {
          "type": "boolean"
        },
        "failure_signal_match": {
          "type": "string",
          "enum": ["any", "all"]
        }
      },
      "additionalProperties": false
    },
    "model_override": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+/[A-Za-z0-9._-]+$"
    },
    "drift_alert_threshold": {
      "description": "Persona-drift alert threshold for this archetype (0.0 = alert on any drift, 1.0 = never alert). Defaults to 0.15 when omitted. Lower it for archetypes whose whole point is a disclosure gradient the simulator must hold.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drift_probes": {
      "description": "Probe questions used by drift probe_mode='active'. Persona-agnostic phrasing only: a probe that restates the persona re-primes the model's attention on it and erases the drift being measured. Omit to use the SDK's built-in probe set.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "additionalProperties": false
}
